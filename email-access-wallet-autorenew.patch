diff --git a/serverv2/src/infrastructure/jobs/queues/auto-renew.queue.js b/serverv2/src/infrastructure/jobs/queues/auto-renew.queue.js
new file mode 100644
index 0000000..02dc654
--- /dev/null
+++ b/serverv2/src/infrastructure/jobs/queues/auto-renew.queue.js
@@ -0,0 +1,23 @@
+import { Queue } from "bullmq";
+import { connection } from "../connection.js";
+
+export const autoRenewQueue = new Queue("auto-renew", { connection });
+
+export async function registerAutoRenewJob() {
+	await autoRenewQueue.upsertJobScheduler(
+		"auto-renew-scheduler",
+		{ pattern: "*/10 * * * *" },
+		{
+			name: "auto-renew-subscriptions",
+			data: {},
+			opts: {
+				attempts: 2,
+				backoff: { type: "exponential", delay: 30000 },
+				removeOnComplete: 20,
+				removeOnFail: 50
+			}
+		}
+	);
+
+	console.log("✅ Auto-renew scheduler registered");
+}
diff --git a/serverv2/src/infrastructure/jobs/workers/auto-renew.worker.js b/serverv2/src/infrastructure/jobs/workers/auto-renew.worker.js
new file mode 100644
index 0000000..e06d952
--- /dev/null
+++ b/serverv2/src/infrastructure/jobs/workers/auto-renew.worker.js
@@ -0,0 +1,20 @@
+import { Worker } from "bullmq";
+import { connection } from "../connection.js";
+import { container } from "../../../container/index.js";
+import { attachWorkerLifecycleLogging } from "../worker-events.js";
+
+export function createAutoRenewWorker() {
+	const worker = new Worker(
+		"auto-renew",
+		async () => {
+			const result = await container.resolve("autoRenewSubscriptions").execute();
+			if (result.renewed || result.failed) {
+				console.log(`[auto-renew] checked ${result.checked}, renewed ${result.renewed}, failed ${result.failed}, skipped ${result.skipped}`);
+			}
+		},
+		{ connection, concurrency: 1 }
+	);
+
+	attachWorkerLifecycleLogging(worker, "auto-renew", { notifyOnFailure: true });
+	return worker;
+}
