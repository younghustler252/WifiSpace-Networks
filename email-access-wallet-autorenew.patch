diff --git a/serverv2/src/modules/user/usecases/admin/admin-change-user-email.usecase.js b/serverv2/src/modules/user/usecases/admin/admin-change-user-email.usecase.js
new file mode 100644
index 0000000..dd3b210
--- /dev/null
+++ b/serverv2/src/modules/user/usecases/admin/admin-change-user-email.usecase.js
@@ -0,0 +1,43 @@
+import { NotFoundError, ForbiddenError, ConflictError, ValidationError } from "../../../../shared/errors/domain.errors.js";
+import { USER_ERROR_CODES, USER_ROLE } from "../../domain/user.enum.js";
+
+export class AdminChangeUserEmail {
+	constructor({ userRepository, auditService, mailService }) {
+		this.userRepository = userRepository;
+		this.auditService = auditService;
+		this.mailService = mailService;
+	}
+
+	async execute({ actorId, actorRole, targetId, email, ip = null }) {
+		const target = await this.userRepository.findById(targetId);
+		if (!target) throw new NotFoundError("User not found", USER_ERROR_CODES.USER_NOT_FOUND);
+
+		if (target.role === USER_ROLE.SUPERADMIN && actorRole !== USER_ROLE.SUPERADMIN) {
+			throw new ForbiddenError("Only a superadmin can modify a superadmin", USER_ERROR_CODES.CANNOT_MODIFY_SUPERADMIN);
+		}
+
+		const next = String(email ?? "").trim().toLowerCase();
+		const previous = target.email;
+
+		if (next === previous) throw new ValidationError("That is already this user's email address", "EMAIL_UNCHANGED");
+		if (await this.userRepository.emailTaken(next, target.id)) {
+			throw new ConflictError("Email already in use", USER_ERROR_CODES.EMAIL_ALREADY_IN_USE);
+		}
+
+		await this.userRepository.commitEmailChange(target.id, next);
+
+		await this.auditService?.log({
+			actorId, action: "USER_EMAIL_CHANGED_BY_ADMIN", resource: "User",
+			metadata: { targetId, previous, next, ip }
+		}).catch((err) => console.error("Audit log failed:", err.message));
+
+		const notice = (to, message) => this.mailService?.sendNotification({
+			to, name: target.firstName, title: "Your email address was changed", message
+		}).catch((err) => console.error("[AdminChangeUserEmail] Notice failed:", err.message));
+
+		notice(next, `An administrator changed the email address on your account to ${next}. Use this address to sign in from now on.`);
+		notice(previous, `An administrator changed the email address on your account from ${previous} to ${next}. If you did not expect this, please contact our support team.`);
+
+		return this.userRepository.findById(target.id);
+	}
+}
diff --git a/serverv2/src/modules/user/usecases/user/confirm-email-change.usecase.js b/serverv2/src/modules/user/usecases/user/confirm-email-change.usecase.js
new file mode 100644
index 0000000..fb56a35
--- /dev/null
+++ b/serverv2/src/modules/user/usecases/user/confirm-email-change.usecase.js
@@ -0,0 +1,54 @@
+import { NotFoundError, ValidationError, ConflictError } from "../../../../shared/errors/domain.errors.js";
+import { USER_ERROR_CODES } from "../../domain/user.enum.js";
+
+const MAX_ATTEMPTS = 5;
+
+export class ConfirmEmailChange {
+	constructor({ userRepository, passwordService, mailService, auditService }) {
+		this.userRepository = userRepository;
+		this.passwordService = passwordService;
+		this.mailService = mailService;
+		this.auditService = auditService;
+	}
+
+	async execute({ userId, otp, ip = null }) {
+		const state = await this.userRepository.getEmailChangeState(userId);
+		if (!state) throw new NotFoundError("User not found", USER_ERROR_CODES.USER_NOT_FOUND);
+		if (!state.pendingEmail || !state.otpHash) {
+			throw new ValidationError("There is no pending email change. Request a new code.", "EMAIL_CHANGE_NOT_REQUESTED");
+		}
+		if (!state.expiresAt || state.expiresAt < Date.now()) {
+			await this.userRepository.clearPendingEmailChange(userId);
+			throw new ValidationError("This code has expired. Request a new one.", "OTP_EXPIRED");
+		}
+		if (state.attempts >= MAX_ATTEMPTS) {
+			await this.userRepository.clearPendingEmailChange(userId);
+			throw new ValidationError("Too many wrong attempts. Request a new code.", "OTP_LOCKED");
+		}
+
+		const valid = await this.passwordService.compare(String(otp), state.otpHash);
+		if (!valid) {
+			await this.userRepository.bumpEmailChangeAttempts(userId);
+			throw new ValidationError("That code is not correct", "OTP_INVALID");
+		}
+
+		if (await this.userRepository.emailTaken(state.pendingEmail, userId)) {
+			await this.userRepository.clearPendingEmailChange(userId);
+			throw new ConflictError("Email already in use", USER_ERROR_CODES.EMAIL_ALREADY_IN_USE);
+		}
+
+		const previous = state.email;
+		await this.userRepository.commitEmailChange(userId, state.pendingEmail);
+
+		await this.auditService?.log({
+			actorId: userId, action: "EMAIL_CHANGED", resource: "User", metadata: { previous, next: state.pendingEmail, ip }
+		}).catch((err) => console.error("Audit log failed:", err.message));
+
+		this.mailService?.sendNotification({
+			to: previous, name: state.firstName, title: "Your email address was changed",
+			message: `The email address on your account was changed to ${state.pendingEmail}. If you did not do this, please contact our support team right away.`
+		}).catch((err) => console.error("[ConfirmEmailChange] Notice failed:", err.message));
+
+		return this.userRepository.findById(userId);
+	}
+}
diff --git a/serverv2/src/modules/user/usecases/user/request-email-change.usecase.js b/serverv2/src/modules/user/usecases/user/request-email-change.usecase.js
new file mode 100644
index 0000000..ae07c05
--- /dev/null
+++ b/serverv2/src/modules/user/usecases/user/request-email-change.usecase.js
@@ -0,0 +1,51 @@
+import { NotFoundError, ValidationError, ConflictError } from "../../../../shared/errors/domain.errors.js";
+import { USER_ERROR_CODES } from "../../domain/user.enum.js";
+
+const OTP_TTL_MS = 10 * 60 * 1000;
+const RESEND_COOLDOWN_MS = 60 * 1000;
+
+export class RequestEmailChange {
+	constructor({ userRepository, passwordService, mailService, auditService }) {
+		this.userRepository = userRepository;
+		this.passwordService = passwordService;
+		this.mailService = mailService;
+		this.auditService = auditService;
+	}
+
+	async execute({ userId, newEmail, password, ip = null }) {
+		const user = await this.userRepository.findAuthById(userId);
+		if (!user) throw new NotFoundError("User not found", USER_ERROR_CODES.USER_NOT_FOUND);
+
+		const validPassword = await this.passwordService.compare(password, user.hashedPassword);
+		if (!validPassword) throw new ValidationError("Password is incorrect", USER_ERROR_CODES.INVALID_OLD_PASSWORD);
+
+		const next = String(newEmail).trim().toLowerCase();
+		if (next === user.email) throw new ValidationError("That is already your email address", "EMAIL_UNCHANGED");
+		if (await this.userRepository.emailTaken(next, user.id)) {
+			throw new ConflictError("Email already in use", USER_ERROR_CODES.EMAIL_ALREADY_IN_USE);
+		}
+
+		const state = await this.userRepository.getEmailChangeState(user.id);
+		if (state?.lastSentAt && Date.now() - state.lastSentAt < RESEND_COOLDOWN_MS) {
+			throw new ValidationError("Please wait before requesting another code", "RESEND_COOLDOWN_ACTIVE");
+		}
+
+		const otp = String(Math.floor(100000 + Math.random() * 900000));
+		const sentAt = Date.now();
+
+		await this.userRepository.setPendingEmailChange(user.id, {
+			pendingEmail: next,
+			otpHash: await this.passwordService.hash(otp),
+			expiresAt: sentAt + OTP_TTL_MS,
+			sentAt
+		});
+
+		await this.mailService.sendEmailChangeOTP({ to: next, name: user.firstName, otp, expiresIn: 10 });
+
+		await this.auditService?.log({
+			actorId: user.id, action: "EMAIL_CHANGE_REQUESTED", resource: "User", metadata: { next, ip }
+		}).catch((err) => console.error("Audit log failed:", err.message));
+
+		return { pendingEmail: next, expiresAt: new Date(sentAt + OTP_TTL_MS), resendAfter: new Date(sentAt + RESEND_COOLDOWN_MS) };
+	}
+}
